# Copy to .env (git-ignored) and fill in. Read by `npm run cli`.

# Keys the local API accepts in the x-api-key header (`npm run cli -- serve`), one per user:
#   FAT_HORSES_API_KEYS=haruka:long-random-key,friend:another-long-random-key
# or a single key for the user "me":
FAT_HORSES_API_KEY=

# Countries addresses are searched in (comma-separated ISO codes). Default: nz. Empty = worldwide.
GEOCODE_COUNTRIES=nz

# Optional identity headers the TAB NZ API docs ask for (see docs/spikes/tab-nz.md).
TAB_FROM=
TAB_PARTNER=
TAB_PARTNER_ID=
